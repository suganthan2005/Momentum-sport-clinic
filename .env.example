# Google Sheets Integration for Assessments
# In Vercel Project Settings -> Environment Variables, add the following variables:

# 1. Google Sheets Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# 2. Google Cloud Service Account Email (make sure this email has "Editor" permissions on your Google Sheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 3. Google Cloud Service Account Private Key (can be pasted with quotes or without quotes, with \n or multi-line)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Sheet Tab Name (defaults to "Assessments" if left unset)
GOOGLE_SHEETS_TAB_NAME=Assessments

